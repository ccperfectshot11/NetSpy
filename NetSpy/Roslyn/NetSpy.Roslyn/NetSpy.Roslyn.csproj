<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <Import Project="..\..\..\NetSpyCommon.props" />

  <PropertyGroup>
    <Copyright>$(NetSpyAssemblyCopyright)</Copyright>
    <Version>$(NetSpyAssemblyVersion)</Version>
    <InformationalVersion>$(NetSpyAssemblyInformationalVersion)</InformationalVersion>

    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\NetSpy.snk</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\Extensions\NetSpy.Debugger\NetSpy.Debugger.DotNet\Metadata\KnownMemberNames.cs" Link="Metadata\KnownMemberNames.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Extensions\NetSpy.Debugger\NetSpy.Debugger.DotNet.Metadata\NetSpy.Debugger.DotNet.Metadata.csproj" />
    <ProjectReference Include="..\..\NetSpy.Contracts.Debugger.DotNet\NetSpy.Contracts.Debugger.DotNet.csproj" />
    <ProjectReference Include="..\..\NetSpy.Contracts.Debugger\NetSpy.Contracts.Debugger.csproj" />
    <ProjectReference Include="..\..\NetSpy.Contracts.NetSpy\NetSpy.Contracts.NetSpy.csproj" />
    <ProjectReference Include="..\..\NetSpy.Contracts.Logic\NetSpy.Contracts.Logic.csproj" />
    <ProjectReference Include="..\NetSpy.Roslyn.CSharp.Internal\NetSpy.Roslyn.CSharp.Internal.csproj" />
    <ProjectReference Include="..\NetSpy.Roslyn.Internal\NetSpy.Roslyn.Internal.csproj" />
    <ProjectReference Include="..\NetSpy.Roslyn.VisualBasic.Internal\NetSpy.Roslyn.VisualBasic.Internal.vbproj" />
    <ProjectReference Include="..\Roslyn.ExpressionCompiler\Core\ExpressionCompiler\ExpressionCompiler.csproj" />
    <ProjectReference Include="..\Roslyn.ExpressionCompiler\CSharp\CSharpExpressionCompiler\CSharpExpressionCompiler.csproj" />
    <ProjectReference Include="..\Roslyn.ExpressionCompiler\VisualBasic\BasicExpressionCompiler\BasicExpressionCompiler.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\NetSpy.Roslyn.Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>NetSpy.Roslyn.Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\NetSpy.Roslyn.Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>NetSpy.Roslyn.Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="$(RoslynVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Features" Version="$(RoslynVersion)" />
    <PackageReference Include="Microsoft.VisualStudio.Language.Intellisense" Version="$(MSVSIntellisenseVersion)" />
    <PackageReference Include="Microsoft.VisualStudio.Text.UI.Wpf" Version="$(MSVSTextVersion)" />
  </ItemGroup>

</Project>
