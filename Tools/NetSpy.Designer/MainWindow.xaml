<Window x:Class="NetSpy.Designer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:NetSpy.Designer.Controls"
        xmlns:m="clr-namespace:NetSpy.Designer.Model"
        xmlns:p="clr-namespace:NetSpy.Designer.Preview"
        Title="NetSpy Designer" Width="1560" Height="940" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/NetSpy.ico"
        Background="#EDEDED" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- ===== Un DataTemplate pentru fiecare tip de setare ===== -->
        <DataTemplate DataType="{x:Type m:ColorSetting}">
            <Grid Margin="0,5" ToolTip="{Binding Hint}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Label}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding Hint}" />
                </StackPanel>
                <c:ColorBox Grid.Column="1" Hex="{Binding Value}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:NumberSetting}">
            <StackPanel Margin="0,5">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource D.Secondary}">
                        <Run Text="{Binding Value, Mode=OneWay}" /><Run Text="{Binding Unit, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Label}" />
                </DockPanel>
                <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Number}"
                        IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,4,0,0" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding Hint}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:BoolSetting}">
            <StackPanel Margin="0,6">
                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsChecked}" Content="{Binding Label}" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding Hint}" Margin="0,2,52,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:ChoiceSetting}">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding Label}" />
                <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedItem="{Binding Selected}" Margin="0,4,0,0" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding Hint}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type m:FontSetting}">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding Label}" />
                <ComboBox ItemsSource="{x:Static m:FontSetting.AllFonts}" IsEditable="True"
                          Text="{Binding Value, UpdateSourceTrigger=LostFocus}" Margin="0,4,0,0" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding Hint}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ===== Bara de sus ===== -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="14,9">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource DesignerButton}" Content="Nou" Click="New_Click" ToolTip="Pornește de la tema implicită" />
                    <Button Style="{StaticResource DesignerButton}" Content="Deschide…" Click="Open_Click" />
                    <Button Style="{StaticResource DesignerButton}" Content="Salvează ca…" Click="SaveAs_Click" />
                    <Button Style="{StaticResource AccentButton}" Content="Salvează" Click="Save_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/NetSpy.ico" Width="22" Height="22" VerticalAlignment="Center" />
                    <TextBlock Text="NetSpy Designer" FontSize="16" FontWeight="SemiBold" Margin="10,0,28,0" VerticalAlignment="Center" />
                    <TextBlock Text="Temă:" VerticalAlignment="Center" Foreground="{StaticResource D.Secondary}" />
                    <ComboBox x:Name="PresetBox" Width="260" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Button Style="{StaticResource DesignerButton}" Content="Aplică tema" Click="ApplyPreset_Click" Margin="6,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Bara de jos ===== -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="14,5">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource D.Secondary}" FontSize="12" />
        </Border>

        <!-- ===== Panoul de setări ===== -->
        <Border DockPanel.Dock="Right" Width="410" Background="#F7F7F7" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Groups" Margin="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:SettingGroup}">
                            <Expander Style="{StaticResource GroupExpander}" Header="{Binding Name}" IsExpanded="{Binding IsExpanded}">
                                <ItemsControl ItemsSource="{Binding Items}" />
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ===== Previzualizarea ===== -->
        <Grid Background="#EDEDED">
            <p:PreviewView x:Name="Preview" Margin="32,28,32,36" />
        </Grid>
    </DockPanel>
</Window>
