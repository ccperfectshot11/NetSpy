<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <Import Project="..\..\NetSpyCommon.props" />

  <PropertyGroup>
    <Copyright>$(NetSpyAssemblyCopyright)</Copyright>
    <Version>$(NetSpyAssemblyVersion)</Version>
    <InformationalVersion>$(NetSpyAssemblyInformationalVersion)</InformationalVersion>

    <AssemblyName>NetSpy.Scripting.Roslyn.x</AssemblyName>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\NetSpy.snk</AssemblyOriginatorKeyFile>
    <OutputPath>..\..\NetSpy\NetSpy\bin\$(Configuration)\</OutputPath>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Include="CSharpInteractive.rsp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="VisualBasicInteractive.rsp" />
    <Compile Remove="VisualBasic\ReplOptionsDefinitions.cs" />
    <None Include="VisualBasic\ReplOptionsDefinitions.cs" />
    <Compile Remove="VisualBasic\VisualBasicToolWindowContent.cs" />
    <None Include="VisualBasic\VisualBasicToolWindowContent.cs" />
    <Compile Remove="VisualBasic\VisualBasicReplSettingsImpl.cs" />
    <None Include="VisualBasic\VisualBasicReplSettingsImpl.cs" />
    <Compile Remove="VisualBasic\VisualBasicControlVM.cs" />
    <None Include="VisualBasic\VisualBasicControlVM.cs" />
    <Compile Remove="VisualBasic\VisualBasicContent.cs" />
    <None Include="VisualBasic\VisualBasicContent.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\NetSpy\NetSpy.Contracts.NetSpy\NetSpy.Contracts.NetSpy.csproj" />
    <ProjectReference Include="..\..\NetSpy\NetSpy.Contracts.Logic\NetSpy.Contracts.Logic.csproj" />
    <ProjectReference Include="..\..\NetSpy\Roslyn\NetSpy.Roslyn\NetSpy.Roslyn.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\NetSpy.Scripting.Roslyn.Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>NetSpy.Scripting.Roslyn.Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\NetSpy.Scripting.Roslyn.Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>NetSpy.Scripting.Roslyn.Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="$(RoslynVersion)" />
    <PackageReference Include="Microsoft.VisualStudio.Text.UI.Wpf" Version="$(MSVSTextVersion)" />
  </ItemGroup>

</Project>
