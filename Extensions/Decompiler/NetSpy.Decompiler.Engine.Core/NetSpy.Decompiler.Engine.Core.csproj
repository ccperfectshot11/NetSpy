<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\NetSpyCommon.props" />

  <PropertyGroup>
    <Copyright>Copyright 2011-2026 AlphaSierraPapa for the SharpDevelop Team, NetSpy contributors</Copyright>
    <Version>$(NetSpyAssemblyVersion)</Version>
    <InformationalVersion>$(NetSpyAssemblyInformationalVersion)</InformationalVersion>

    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\..\NetSpy.snk</AssemblyOriginatorKeyFile>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Update="Properties\NetSpy.Decompiler.Engine.Core.Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>NetSpy.Decompiler.Engine.Core.Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\NetSpy.Decompiler.Engine.Core.Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>NetSpy.Decompiler.Engine.Core.Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\NetSpy\NetSpy.Contracts.Logic\NetSpy.Contracts.Logic.csproj" />
    <ProjectReference Include="..\..\..\NetSpy\NetSpy.Decompiler.Core\NetSpy.Decompiler.Core.csproj" />
    <!-- Modern NetSpy engine (vendored source, see ..\NetSpy.Decompiler\ENGINE_VERSION.txt) -->
    <ProjectReference Include="..\NetSpy.Decompiler\NetSpy.Decompiler.csproj" />
  </ItemGroup>

</Project>
