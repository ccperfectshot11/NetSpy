<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:settings="clr-namespace:NetSpy.Decompiler.Engine.Settings"
                    xmlns:p="clr-namespace:NetSpy.Decompiler.Engine.Core.Properties;assembly=NetSpy.Decompiler.Engine.Core"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate DataType="{x:Type settings:CSharpDecompilerSettingsPage}">
        <ItemsControl Margin="5" ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <GroupBox Margin="0 0 0 5" Header="{Binding Title}">
                        <ItemsControl Margin="0 3 0 0" ItemsSource="{Binding Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="0 0 0 5" IsChecked="{Binding IsChecked}" Content="{Binding Text}" ToolTip="{Binding ToolTip}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <DataTemplate DataType="{x:Type settings:ILDecompilerSettingsPage}">
        <StackPanel Margin="5">
            <CheckBox Margin="0 0 0 0" IsChecked="{Binding Settings.ShowXmlDocumentation}" Content="{x:Static p:NetSpy_Decompiler_Engine_Core_Resources.DecompilerSettings_ShowXMLDocComments}"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.ShowTokenAndRvaComments}" Content="{x:Static p:NetSpy_Decompiler_Engine_Core_Resources.DecompilerSettings_ShowTokensRvasOffsets}"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.ShowILBytes}" Content="{x:Static p:NetSpy_Decompiler_Engine_Core_Resources.DecompilerSettings_ShowILInstrBytes}"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.ShowILComments}" Content="{x:Static p:NetSpy_Decompiler_Engine_Core_Resources.DecompilerSettings_ShowILComments}"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.SortMembers}" Content="{x:Static p:NetSpy_Decompiler_Engine_Core_Resources.DecompilerSettings_SortMethods}"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.ShowPdbInfo}" Content="{x:Static p:NetSpy_Decompiler_Engine_Core_Resources.DecompilerSettings_ShowPdbInfo}"/>
            <CheckBox Margin="0 5 0 0" IsChecked="{Binding Settings.HexadecimalNumbers}" Content="{x:Static p:NetSpy_Decompiler_Engine_Core_Resources.DecompilerSettings_HexadecimalNumbers}"/>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
